# Plantilla de configuración de Coturn (STUN/TURN) para servidor Linux (/etc/turnserver.conf)
#
# Pasos de instalación en Ubuntu / Debian Linux:
#   1. sudo apt update && sudo apt install -y coturn
#   2. Habilitar servicio en /etc/default/coturn: TURNSERVER_ENABLED=1
#   3. Copiar esta plantilla a /etc/turnserver.conf y reemplazar realm y user
#   4. Abrir puertos en firewall:
#        sudo ufw allow 3478/tcp
#        sudo ufw allow 3478/udp
#        sudo ufw allow 5349/tcp
#        sudo ufw allow 49152:65535/udp
#   5. Activar servicio: sudo systemctl enable --now coturn

# Puertos de escucha STUN/TURN y TLS
listening-port=3478
tls-listening-port=5349

# Requerido por WebRTC y mecanismo de credenciales de largo plazo
fingerprint
lt-cred-mech

# Reemplazar por tu dominio y credenciales reales antes de desplegar
realm=REEMPLAZAR_POR_TU_DOMINIO
user=REEMPLAZAR_USUARIO:REEMPLAZAR_CONTRASENA

# Rango de puertos UDP para retransmisión multimedia (relay)
min-port=49152
max-port=65535

# Seguridad, prevención de relay multicast y registro de actividad
no-multicast-peers
stale-nonce=600
log-file=/var/log/turnserver.log
simple-log

# Si el servidor Linux está detrás de NAT (ej. VPS/AWS/GCP), descomentar y ajustar:
# external-ip=IP_PUBLICA/IP_PRIVADA
# En producción configura también cert y pkey para TLS (turns:).
